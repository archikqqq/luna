{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luna",
  "version": "0.1.0",
  "identifier": "com.tguse.luna",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Luna",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.local; img-src 'self' asset: https://asset.local data:; style-src 'self' 'unsafe-inline'; font-src 'self' asset: https://asset.local; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Luna Project",
    "copyright": "Copyright © 2026 Luna Project",
    "shortDescription": "Desktop AI client for Windows",
    "longDescription": "Luna is a desktop AI client with secure provider keys, streaming responses and persistent local conversations.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "headerImage": "icons/installer-header.bmp",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "startMenuFolder": "Luna"
      }
    }
  }
}
